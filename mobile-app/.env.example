# Copy to .env only if you need to override the defaults.
# Never put access tokens or other secrets in this file.
# Expo includes every EXPO_PUBLIC_ variable in the client bundle.

# FastAPI base URL, with no trailing slash.
EXPO_PUBLIC_API_URL=http://localhost:8000

# Sprint 1 reads and writes sample data on the device.
# Set this to false to call GET /items and GET /items/{id}.
# POST /items still requires a signed-in session, which this release does not collect.
EXPO_PUBLIC_USE_MOCK=true
