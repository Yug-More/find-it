# Copy to .env only if you need to override the defaults.
# Never put access tokens, service-role keys, JWT secrets, or other secrets in this file.
# Expo includes every EXPO_PUBLIC_ variable in the client bundle.

# Supabase project URL from Project Settings -> API.
EXPO_PUBLIC_SUPABASE_URL=

# Supabase anon public key. This is the client key, not the service-role key.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# FastAPI base URL, with no trailing slash.
EXPO_PUBLIC_API_URL=http://localhost:8000

# true uses sample data on the device. false calls the API.
# Live POST /items still needs a signed-in Supabase session.
EXPO_PUBLIC_USE_MOCK=true
