# Supabase project settings (Project Settings > API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# JWT secret used to verify legacy HS256 tokens. Modern Supabase projects sign
# tokens with asymmetric ES256/RS256 keys published via JWKS
# (<supabase_url>/auth/v1/.well-known/jwks.json); the secret is only a fallback.
SUPABASE_JWT_SECRET=your-jwt-secret

# Gemini API (used for text embeddings) - free tier, get a key at aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=1536

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:19006,http://localhost:8081
